{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "analytics",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://ej",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "",
    "NEXT_PUBLIC_SITE_URL": "https://analytics.sufyaanstudio.workers.dev",
    "NEXT_PUBLIC_COLLECT_URL": "https://analytics-collect.sufyaanstudio.workers.dev"
  }
}
