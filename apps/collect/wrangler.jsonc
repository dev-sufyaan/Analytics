{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "analytics-collect",
  "account_id": "e6544ce571128ed8fa400651fa2d3e8c",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "15 0 * * *"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "SITE_CACHE",
      "id": "6bacb5c306ba4ffdaae42035296a1f64"
    }
  ]
}