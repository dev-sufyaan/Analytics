{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "analytics-collect",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["15 0 * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "SITE_CACHE"
    }
  ]
}
