# PostHog browser analytics (US region — use eu.i.posthog.com for EU)
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Events are proxied via Next.js rewrites at /ingest → US host (ad-blocker bypass).
# Client uses api_host '/ingest' (see src/instrumentation-client.ts). No extra env needed.
